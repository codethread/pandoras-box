FROM node:24-bookworm-slim

ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH

RUN apt-get update \
	&& apt-get install -y --no-install-recommends \
		build-essential \
		ca-certificates \
		git \
		python3 \
		sqlite3 \
		tmux \
	&& corepack enable \
	&& corepack prepare pnpm@10.34.1 --activate \
	&& rm -rf /var/lib/apt/lists/*

WORKDIR /workspace
