exports[`renderHelp > renders leaf help from args, options, pseudo names, choices, repeats, defaults, and descriptions 1`] = `
"demo item inspect

Inspect one item.

Usage:
  demo item inspect [--json] [--data-dir path] [--limit count] [--workers count] --mode short | full [--tag tag...] [--literal text] <item-id>

Arguments:
  <item-id>  Item to inspect.

Options:
  --json               Return structured JSON.
  --data-dir path      Directory containing demo state.
  --limit count        Maximum records to show.
  --workers count      Worker count. Default: 4.
  --mode short | full  Inspection detail level.
  --tag tag...         Filter by tag; repeated values are ORed.
  --literal text       One of the following: keep this authored sentence.
"
`;

